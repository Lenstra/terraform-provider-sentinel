// A plan where every resource carries the required tags.

resource_changes = {
	"aws_instance.web": {
		"address": "aws_instance.web",
		"mode":    "managed",
		"type":    "aws_instance",
		"name":    "web",
		"change": {
			"actions": ["create"],
			"after": {
				"instance_type": "t3.micro",
				"tags": {
					"Environment": "production",
					"Owner":       "platform",
				},
			},
		},
	},
}
