// A plan that creates an instance type outside the allowed list.

resource_changes = {
	"aws_instance.web": {
		"address": "aws_instance.web",
		"mode":    "managed",
		"type":    "aws_instance",
		"name":    "web",
		"change": {
			"actions": ["create"],
			"after": {
				"instance_type": "m5.4xlarge",
				"tags": {
					"Environment": "production",
					"Owner":       "platform",
				},
			},
		},
	},
}
